# Xiaomi Pad 6 (pipa): postmarketOS "linux-xiaomi-pipa" kernel as an Arch/Artix PKGBUILD
# Source of truth: pmaports device/testing/linux-xiaomi-pipa (vanilla kernel.org tarball + patch series)
#
# Split package: linux-pipa-pmos (kernel+modules) and linux-pipa-pmos-headers (built from the same tree).
#
# Update from postmarketOS: run ./sync-pmaports.sh (pulls kernel version, patches, config
# and checksums from pmaports into the generated block below; build with makepkg after).
#
# The ESP is your 'cust' partition, mounted at /boot/efi (/boot stays on the rootfs).
# A PreTransaction hook (00-pipa-mount-esp) mounts it before pacman unpacks anything, so
# the package installs straight onto the ESP:
#   /boot/efi/EFI/BOOT/BOOTAA64.EFI      (the EFI-stub kernel)
#   /boot/efi/sm8250-xiaomi-pipa.dtb     (panel picked by _panel)
#   /boot/efi/dtbs/qcom/*.dtb            (both panel DTBs)
#   /boot/efi/initramfs.img              (written by mkinitcpio)
# FIRST install only: the hook is not installed yet, so mount cust by hand once:
#   mkdir -p /boot/efi && mount -o quiet /dev/disk/by-partlabel/cust /boot/efi
# Switch panel later: rebuild with the other _panel, or
#   cp /boot/efi/dtbs/qcom/sm8250-xiaomi-pipa-tianma.dtb /boot/efi/sm8250-xiaomi-pipa.dtb
# (a manual copy is overwritten by the next kernel upgrade).

_panel=csot          # csot | tianma
_efistub=1           # 1 = boot the kernel straight from the ESP (no GRUB):
                     #     installs it as /boot/efi/EFI/BOOT/BOOTAA64.EFI and bakes
                     #     cmdline.txt + initrd=/dtb= into CONFIG_CMDLINE
                     # 0 = plain /boot/Image for GRUB / other loader
_rust=0              # 1 = keep CONFIG_RUST=y (needs rust, rust-bindgen, rust-src)

pkgbase=linux-pipa-pmos
pkgname=("$pkgbase" "$pkgbase-headers")
_flavor=xiaomi-pipa
# >>> pmaports-sync: generated by sync-pmaports.sh, do not edit >>>
pkgver=7.2.4
_tar_sum='e48921e0d45b6b2bb19052e44e057fc15f337ed1740e3a3be5f51e272a59332cecd5bdf23b0f44f08c28963c39b29fdcf944ec57a86f9281907502714d6fb833'
