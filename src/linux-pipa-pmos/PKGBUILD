# <<< pmaports-sync <<<
pkgrel=2
pkgdesc="Linux $pkgver for Xiaomi Pad 6 (postmarketOS patchset)"
arch=('aarch64')
url="https://kernel.org"
license=('GPL-2.0-only')
makedepends=('bc' 'cpio' 'perl' 'python' 'tar' 'xz' 'zstd' 'kmod' 'inetutils'
             'pahole' 'libelf' 'clang' 'llvm' 'lld' 'dtc')
options=('!strip' '!debug')
_desc="Xiaomi Pad 6 (postmarketOS patchset)"

# _pmos_files = config + patches, _pmos_sums = their checksums, _tar_sum = kernel tarball
# (all taken from pmaports by sync-pmaports.sh). The last four are our own files.
source=("linux-$pkgver.tar.xz::https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$pkgver.tar.xz"
        "${_pmos_files[@]}"
        'linux-pipa.preset'
        'cmdline.txt'
        '00-pipa-mount-esp.hook'
        'pipa-mount-esp')

_make() { make ARCH=arm64 LLVM=1 "$@"; }

prepare() {
  cd "linux-$pkgver"

  local p
  for p in "$srcdir"/0*.patch; do
    msg2 "Applying ${p##*/}"
    patch -Np1 -i "$p"
  done

  # base config = pmaports config-xiaomi-pipa.aarch64
  cp "$srcdir/config-$_flavor.aarch64" .config
  echo "-$pkgrel" > localversion.10-pkgrel

  (( _rust )) || scripts/config -d RUST

  if (( _efistub )); then
    # Built-in command line used by the EFI stub when firmware passes none.
    # Forward slashes avoid backslash-escaping trouble; the stub converts them.
    local cmdline
    cmdline="$(tr -d '\n' < "$srcdir/cmdline.txt") initrd=/initramfs.img dtb=/sm8250-xiaomi-pipa.dtb"
    scripts/config --set-str CMDLINE "$cmdline"
  fi

  # pmOS config was generated with Alpine clang 22 / rustc 1.97; adapt to the local toolchain
  _make olddefconfig

  if (( _efistub )) && ! grep -q '^CONFIG_CMDLINE=".*dtb=' .config; then
    error "CONFIG_CMDLINE did not survive olddefconfig (symbol layout changed?)"
    return 1
  fi

  _make -s kernelrelease > version
}

build() {
  cd "linux-$pkgver"
  unset LDFLAGS
  _make -j"$(nproc)" Image modules
  # both panel DTBs; -@ keeps symbols for overlays
  _make DTC_FLAGS="-@" qcom/sm8250-xiaomi-pipa-csot.dtb qcom/sm8250-xiaomi-pipa-tianma.dtb
}

_package() {
  cd "linux-$pkgver"
  local kernver; kernver="$(<version)"
  local modulesdir="$pkgdir/usr/lib/modules/$kernver"
  local dts=arch/arm64/boot/dts/qcom

  # uncompressed arm64 Image is itself a PE/COFF EFI application (CONFIG_EFI_STUB)
  local esp=boot
  (( _efistub )) && esp=boot/efi

  if (( _efistub )); then
    install -Dm644 arch/arm64/boot/Image "$pkgdir/$esp/EFI/BOOT/BOOTAA64.EFI"
    install -Dm644 "$srcdir/00-pipa-mount-esp.hook" \
      "$pkgdir/usr/share/libalpm/hooks/00-pipa-mount-esp.hook"
    install -Dm755 "$srcdir/pipa-mount-esp" \
      "$pkgdir/usr/share/libalpm/scripts/pipa-mount-esp"
  else
    install -Dm644 arch/arm64/boot/Image -t "$pkgdir/boot"
  fi

  install -Dm644 "$dts/sm8250-xiaomi-pipa-csot.dtb" "$dts/sm8250-xiaomi-pipa-tianma.dtb" \
    -t "$pkgdir/$esp/dtbs/qcom"
  install -Dm644 "$dts/sm8250-xiaomi-pipa-$_panel.dtb" \
    "$pkgdir/$esp/sm8250-xiaomi-pipa.dtb"

  _make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
    DEPMOD=/doesnt/exist modules_install
  rm -f "$modulesdir"/{build,source}

  # initramfs lands on the ESP too (cmdline.txt is baked into the kernel, nothing to install)
  sed "s|%PKGBASE%|$pkgbase|g; s|%KERNVER%|$kernver|g; s|/boot/initramfs.img|/$esp/initramfs.img|" \
    "$srcdir/linux-pipa.preset" |
    install -Dm644 /dev/stdin "$pkgdir/etc/mkinitcpio.d/$pkgbase.preset"

  # makes mkinitcpio's pacman hook rebuild the initramfs (-> /$esp/initramfs.img)
  install -d "$pkgdir/usr/lib/initcpio"
  echo "dummy file to trigger mkinitcpio" > "$pkgdir/usr/lib/initcpio/$kernver"
}

package_linux-pipa-pmos() {
  pkgdesc="The Linux kernel and modules - $_desc"
  depends=('coreutils' 'kmod' 'mkinitcpio>=0.7')
  optdepends=('wireless-regdb: correct wireless channels for your country')
  provides=("linux=$pkgver")
  conflicts=('linux' 'linux-pipa')

  _package
}

package_linux-pipa-pmos-headers() {
  pkgdesc="Headers and scripts for building modules for the linux-pipa-pmos kernel"
  # kernel is built with LLVM=1, so external modules need the same toolchain
  depends=('pahole' 'clang' 'llvm' 'lld')
  provides=("linux-headers=$pkgver")
  conflicts=('linux-headers' 'linux-pipa-headers')

  cd "linux-$pkgver"
  local builddir="$pkgdir/usr/lib/modules/$(<version)/build"

  echo "Installing build files..."
  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
    localversion.* version vmlinux
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/arm64" -m644 arch/arm64/Makefile
  cp -t "$builddir" -a scripts

  # host tools needed when objtool / BTF are enabled (absent on some arm64 configs)
  [[ -x tools/objtool/objtool ]] && \
    install -Dt "$builddir/tools/objtool" tools/objtool/objtool
  [[ -x tools/bpf/resolve_btfids/resolve_btfids ]] && \
    install -Dt "$builddir/tools/bpf/resolve_btfids" tools/bpf/resolve_btfids/resolve_btfids

  echo "Installing headers..."
  cp -t "$builddir" -a include
  cp -t "$builddir/arch/arm64" -a arch/arm64/include
  install -Dt "$builddir/arch/arm64/kernel" -m644 arch/arm64/kernel/asm-offsets.s
  mkdir -p "$builddir/arch/arm"
  cp -t "$builddir/arch/arm" -a arch/arm/include   # CONFIG_COMPAT / vdso32

  install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
  install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h
  install -Dt "$builddir/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h
  install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
  install -Dt "$builddir/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
  install -Dt "$builddir/drivers/media/tuners" -m644 drivers/media/tuners/*.h
  install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h

  echo "Installing Kconfig files..."
  find . -name 'Kconfig*' -exec install -Dm644 {} "$builddir/{}" \;

  echo "Removing unneeded architectures..."
  local a
  for a in "$builddir"/arch/*/; do
    [[ $a = */arm64/ || $a = */arm/ ]] && continue
    rm -r "$a"
  done

  echo "Removing documentation..."
  rm -rf "$builddir/Documentation"

  echo "Removing broken symlinks and loose objects..."
  find -L "$builddir" -type l -delete
  find "$builddir" -type f -name '*.o' -delete

  echo "Stripping build tools..."
  local file
  while read -rd '' file; do
    case "$(file -bi "$file")" in
      application/x-sharedlib\;*)      strip -v $STRIP_SHARED "$file" ;;
      application/x-archive\;*)        strip -v $STRIP_STATIC "$file" ;;
      application/x-executable\;*)     strip -v $STRIP_BINARIES "$file" ;;
      application/x-pie-executable\;*) strip -v $STRIP_SHARED "$file" ;;
    esac
  done < <(find "$builddir" -type f -perm -u+x ! -name vmlinux -print0)

  strip -v $STRIP_STATIC "$builddir/vmlinux"

  echo "Adding symlink..."
  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}

sha512sums=("$_tar_sum"
            "${_pmos_sums[@]}"
            'SKIP' 'SKIP' 'SKIP' 'SKIP')   # our own files: preset, cmdline, hook, script
