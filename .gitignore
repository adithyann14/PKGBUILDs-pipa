# makepkg leftovers inside package folders (CI builds in /tmp; finished packages are
# committed to the repo ROOT on purpose, so *.pkg.tar.* is NOT ignored there)
/*/src/
/*/pkg/
/src/*/src/
/src/*/pkg/
/*/*.pkg.tar.*
/src/*/*.pkg.tar.*
*.log
*.swp
*~

# repo/ ships only *.pkg.tar.xz + pipa-pmos.db + pipa-pmos.files; the .tar.zst duplicates stay local
/repo/pipa-pmos.db.tar*
/repo/pipa-pmos.files.tar*
*.old
*.sig
!/repo/*.pkg.tar.xz
